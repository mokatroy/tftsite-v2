{
  "name": "mokatroy-tft-overlay",
  "version": "0.1.3",
  "description": "A lightweight desktop companion for MokaTroy TFT.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "package:win": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.mokatroy.tftoverlay",
    "productName": "MokaTroy TFT Overlay",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png",
      "build/icon.ico",
      "icon.png",
      "icon.ico"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "mokatroy",
        "repo": "tftsite-v2",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "icon": "build/icon.ico"
  },
  "author": "MokaTroy"
}
